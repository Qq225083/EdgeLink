# EdgeLink 后端环境变量模板
# 复制此文件为 .env.dev 或 .env.prod，并填入实际值
# 生产环境必须设置 APP_ENV=prod，开发环境设置 APP_ENV=dev

# ===== 运行环境 =====
# 必选：dev / prod / staging / docker
APP_ENV=dev

# ===== 应用配置 =====
APP_HOST=0.0.0.0
APP_PORT=9099
APP_VERSION=1.0.0
APP_RELOAD=true
APP_IP_LOCATION_QUERY=true
APP_SAME_TIME_LOGIN=true

# ===== JWT 配置 =====
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REDIS_EXPIRE_MINUTES=30

# ===== 监控上报 API Key =====
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
MONITOR_API_KEY=your-monitor-api-key-min-32-chars

# ===== 数据库配置 =====
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(16))"
DB_PASSWORD=your-strong-database-password
DB_DATABASE=ruoyi-fastapi
DB_ECHO=false

# ===== Redis 配置 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===== MQTT Broker（EMQX）配置 =====
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# ===== 代码生成配置 =====
GEN_AUTHOR=ruoyi
GEN_PACKAGE_NAME=module_plc
GEN_AUTO_REMOVE_PRE=false
GEN_TABLE_PREFIX=plc_

# ===== 上传配置 =====
UPLOAD_PATH=./upload_path
