    {
        "id": "func-stress-mon",
        "type": "function",
        "z": "tab-stress-01",
        "name": "📊 统计报告",
        "func": "var ctx = context.global || context;\nvar oldCount = ctx.get('old_count') || 0;\nvar newCount = ctx.get('new_count') || 0;\nvar mem = process.memoryUsage();\n\nvar report = {\n    time: new Date().toISOString(),\n    old_count: oldCount,\n    new_count: newCount,\n    heap_mb: (mem.heapUsed / 1024 / 1024).toFixed(1),\n    diff_count: newCount - oldCount\n};\n\nnode.warn(JSON.stringify(report));\nmsg.payload = report;\nreturn msg;",
